#!/bin/bash

# collie:summary=Install and configure Voxtype dictation
# collie:requires-sudo=true

set -e

voxtype_lib_path="${COLLIE_VOXTYPE_LIB_PATH:-/usr/lib/voxtype}"

if collie-cmd-missing voxtype; then
  if gum confirm --affirmative "$(collie-i18n common.yes)" --negative "$(collie-i18n common.no)" "$(collie-i18n dictation.installVoxtype)"; then
    collie-pkg-add wtype voxtype-bin
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$COLLIE_PATH/default/voxtype/config.toml" "$config_home/voxtype/"
  # A Vulkan runtime is not enough: aarch64 voxtype-bin ships no Vulkan backend.
  if collie-hw-vulkan && [[ -x $voxtype_lib_path/voxtype-vulkan ]]; then
    voxtype setup gpu --enable || true
  fi
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install
voxtype setup systemd
systemctl --user enable --now voxtype.service

collie-dictation-use voxtype
collie-restart-hyprctl
collie-notification-send -g  "$(collie-i18n dictation.voxtypeReady)" "$(collie-i18n dictation.hint)" -t 10000
