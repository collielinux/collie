#!/bin/bash

# collie:summary=Clear the shell update indicator after an update
# collie:hidden=true

# collie-update now clears the indicator itself. This stays for an update
# started by an older collie-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
collie-shell -q collie.system-update clear
