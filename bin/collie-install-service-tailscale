#!/bin/bash

# collie:summary=Install the Tailscale mesh VPN service and a web app for the Tailscale Admin Console.
# collie:requires-sudo=true

echo -e "\nInstalling Tailscale..."
collie-pkg-add tailscale

echo -e "\nStarting Tailscale..."
sudo systemctl enable --now tailscaled.service
sudo tailscale up --accept-routes

echo -e "\nAllowing $USER to manage Tailscale..."
sudo tailscale set --operator="$USER"

echo -e "\nReceiving Taildrop files in $HOME/Downloads..."
systemctl --user enable --now collie-tailscale-receive.service

echo -e "\nAdding Tailscale to the bar..."
collie-plugin-enable collie.tailscale

collie-webapp-install "Tailscale" "https://login.tailscale.com/admin/machines" https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale-light.png
