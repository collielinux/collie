#!/bin/bash

# collie:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Collie default and rebuild it.
# collie:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$COLLIE_PATH/bin/collie-plymouth-set" --refresh-default
