#!/bin/bash -p

# collie:summary=Detect whether the computer is an Apple Silicon Mac (the old name of collie-hw-aarch64-apple).
# collie:hidden=true

# Kept while omarchy-mac's packages and units still call it by this name. Like
# the predicate it runs, it refuses a launch without -p and searches no PATH.
if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

dir=${BASH_SOURCE[0]%/*}
[[ $dir != "${BASH_SOURCE[0]}" ]] || dir=.
exec "$dir/collie-hw-aarch64-apple"
