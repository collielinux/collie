#!/bin/bash

# collie:summary=Apply Collie hardware-specific packages and system configuration
# collie:group=apply
# collie:requires-sudo=true
# collie:examples=collie apply hardware --install-user dhh
# collie:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: collie apply hardware --install-user USER
       collie apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by collie-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/collie/provisioning/groups.

In an image build (/var/lib/collie/image/target exists) nothing runs here: every step is queued
for collie-provision-hardware on the machine's first boot.
USAGE
}

install_user="${COLLIE_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: collie-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export COLLIE_INSTALL_USER="$install_user"
# Only collie-provision-hardware runs steps as an image's first boot.
unset COLLIE_IMAGE_DEFERRED_HARDWARE
export COLLIE_PATH="${COLLIE_PATH:-/usr/share/collie}"
export COLLIE_INSTALL="${COLLIE_INSTALL:-$COLLIE_PATH/install}"
export COLLIE_INSTALL_LOG_FILE="${COLLIE_INSTALL_LOG_FILE:-/var/log/collie-install.log}"
export PATH="$COLLIE_PATH/bin:$PATH"

source "$COLLIE_INSTALL/helpers/logging.sh"
source "$COLLIE_INSTALL/helpers/image-target.sh"

collie_image_init
collie_image_lock
if collie_image_manifest_present; then
  collie_image_read_manifest
  collie_image_defer_hardware
else
  source "$COLLIE_INSTALL/hardware/all.sh"
fi
