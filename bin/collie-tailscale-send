#!/bin/bash

# collie:summary=Send files to a machine on your tailnet with Taildrop
# collie:args=<machine> [file...]
# collie:examples=collie tailscale send dhh-fd | collie tailscale send dhh-fd ~/Downloads/notes.pdf

set -euo pipefail

if (($# < 1)); then
  echo "Usage: collie-tailscale-send <machine> [file...]" >&2
  exit 1
fi

machine="$1"
shift

# Address the machine by whatever name we were handed, but talk about it by
# its short name, so a MagicDNS name does not spill into every message.
name="${machine%%.*}"

files=("$@")

if ((${#files[@]} == 0)); then
  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to send.
  picked=$(collie-file-select --title "$(collie-i18n tailscale.sendToTitle "$name")" --multiple) || status=$?

  if ((${status:-0} > 1)); then
    collie-notification-send -g "󰒊" -u critical "$(collie-i18n tailscale.sendFailed "$name")" \
      "$(collie-i18n share.chooserClosed)"
    exit 1
  fi

  readarray -t files <<<"$picked"
  [[ -n $picked ]] || exit 0
fi

if ((${#files[@]} == 1)); then
  what=$(basename "${files[0]}")
else
  what=$(collie-i18n --count "${#files[@]}" tailscale.fileCount "${#files[@]}")
fi

if error=$(tailscale file cp --update-interval=0 -- "${files[@]}" "$machine:" 2>&1); then
  collie-notification-send -g "󰒊" "$(collie-i18n tailscale.sent "$name")" "$what"
else
  collie-notification-send -g "󰒊" -u critical "$(collie-i18n tailscale.sendFailed "$name")" "${error:-$(collie-i18n tailscale.transferFailed)}"
  exit 1
fi
