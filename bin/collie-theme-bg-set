#!/bin/bash

# collie:summary=Set the current background image or video
# collie:args=<path-to-media>
# collie:examples=collie theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: collie-theme-bg-set <path-to-media>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/collie/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# A theme switch repoints the background too, so the two take turns.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/collie-theme-set.lock"
flock 9

INTRO=$(collie-theme-bg-boot-intro --resolve-enabled "$BACKGROUND")

# The shell sequences the change, with the intro or the ordinary transition,
# and repoints the link itself once nothing on screen can flash.
if [[ $(collie-shell shell switchBackground "$BACKGROUND" "$INTRO" 2>/dev/null) != "ok" ]]; then
  ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"
  collie-shell -q background set "$BACKGROUND"
fi
