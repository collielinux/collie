#!/bin/bash

# collie:summary=Install and start the Dropbox service. Must then be authenticated via the web.
# collie:requires-sudo=true

echo "Installing all dependencies..."
collie-pkg-add dropbox dropbox-cli libappindicator python-gpgme nautilus-dropbox

echo "Adding Dropbox to the bar..."
collie-plugin-enable collie.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
