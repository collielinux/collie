#!/usr/bin/python3
# collie:summary=Play a realistic run of notifications to look at the notification UI
# collie:hidden=true
"""A realistic run of notifications, sent straight onto the session bus as an
app would: a stack building, a code to copy, a link to open, and the apps this
desktop has icons for. The senders mimic what really notifies this desktop
(Chrome web apps, chat apps, a terminal); the words are invented and the only
people named are Collie's own."""
import subprocess
import time

from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.Notifications"
BUS_PATH = "/org/freedesktop/Notifications"
GAP = 3.2

# Chrome sends every web app as "Google Chrome"; the leading origin anchor is
# what tells the sites apart. The Campfire burst arrives faster than the pace
# so a stack builds. The system apps are ones this desktop has icons for, so a
# letter tile there means a bug.
NOTIFICATIONS = [
  dict(web="linear.app", summary="Collie",
       body="Jill: notification decks just landed on edge, worth a look before the call"),
  dict(app="Messages", icon="org.gnome.Messages", summary="Ryan Hughes",
       body="I have to show you the new notifications, are you around later?"),
  dict(web="mail.proton.me", summary="New Email in Inbox",
       body="Re: Collie 4.5 release notes"),
  dict(web="x.com", summary="Jill",
       body="replied to your post: this is the part everyone gets wrong"),
  dict(web="linear.app", summary="Collie", gap=0.7,
       body="Ryan Hughes: pushed the spacing pass, take a look"),
  dict(web="linear.app", summary="Collie", gap=0.7,
       body="Jill: the two-line ones finally breathe"),
  dict(web="linear.app", summary="Collie", gap=0.7,
       body="Ryan Hughes: one more go at the icon size and I think that is it"),
  dict(web="linear.app", summary="Collie",
       body="Jill: ship it, latest build is up at https://collie.dev"),
  dict(app="Grok Bot", icon="grok-bot", summary="Grok Bot", actions=["default=View"],
       body="2 things need you since lunch: Jill asked about the 4.5 release notes, "
            "and the Omapager PR has a new review waiting on you."),
  dict(web="linear.app", summary="Jill assigned you a to-do",
       body="Record the notifications demo for the 4.5 release notes"),
  dict(web="mail.proton.me", summary="New Email in Inbox",
       body="Your verification code is 482913"),
  dict(app="foot", icon="foot", summary="Tests passed",
       body="412 passed, 0 failed in <b>2m 14s</b>"),
  dict(app="Collie", icon="collie", summary="Collie 4.5 is out",
       body="Notification decks, one-click codes, and a lot more"),
  dict(app="Spotify", icon="spotify", summary="Now playing",
       body="Money for Nothing - Dire Straits"),
  dict(web="x.com", summary="3 people liked your post",
       body="“the notification daemon is the whole desktop in miniature”"),
  dict(app="Messages", icon="org.gnome.Messages", summary="Jill",
       body="seriously, you are going to want to see this one"),
  dict(app="Collie", icon="system-software-update", summary="Updates available",
       body="14 packages, including linux 7.2.8 and hyprland 0.56.2"),
  dict(app="Snapshots", icon="LimineSnapperSync", summary="Snapshot complete",
       body="pre-update root snapshot written in 4s"),
  dict(app="ApexShot", icon="apexshot", summary="Screenshot saved",
       body="~/Screenshots/ApexShot-2026-09-03_22-41-08.png"),
]


def send(bus, n):
  app, icon, body = n.get("app", ""), n.get("icon", ""), n["body"]
  if n.get("web"):
    app, icon = "Google Chrome", "google-chrome"
    body = '<a href="https://%s/">%s</a>\n\n%s' % (n["web"], n["web"], body)
  actions = []
  for action in n.get("actions", []):
    key, _, label = action.partition("=")
    actions += [key, label]
  hints = {"desktop-entry": GLib.Variant("s", icon)}
  bus.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, "Notify",
                GLib.Variant("(susssasa{sv}i)", (app, 0, icon, n["summary"], body, actions, hints, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 5000, None)


def main():
  bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
  # Off screen, not forgotten: history keeps what was there.
  subprocess.run(["collie-shell", "-q", "notifications", "dismissAll"], check=False)
  time.sleep(0.4)
  try:
    for n in NOTIFICATIONS:
      send(bus, n)
      time.sleep(n.get("gap", GAP))
  except KeyboardInterrupt:
    pass


if __name__ == "__main__":
  main()
