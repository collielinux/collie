#!/bin/bash

# collie:summary=Rename a Claude, Codex, or Grok subscription account
# collie:args=[claude|codex|grok] <account> <name>
# collie:examples=collie agent account rename primary Hey | collie agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `collie agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(collie-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || (( $# < 3 )); then
  echo "Usage: collie-agent-account-rename [claude|codex|grok] <account> <name>" >&2
  exit 1
fi

account=$(collie-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: collie agent account use $1 $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
collie-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
