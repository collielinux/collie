#!/bin/bash

# collie:summary=Install Slack Desktop with live Collie theme support
# collie:requires-sudo=true

set -euo pipefail

collie-pkg-add slack-desktop
if collie-setup-slack; then
  setsid uwsm-app -- gtk-launch slack >/dev/null 2>&1 &
else
  echo "Slack theme setup failed; opening packaged Slack." >&2
  setsid uwsm-app -- gio launch /usr/share/applications/slack.desktop >/dev/null 2>&1 &
fi
