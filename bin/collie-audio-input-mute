#!/bin/bash

# collie:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  collie-brightness-keyboard-mute on
  collie-osd -i microphone-muted -m "$(collie-i18n audio.micMuted)"
else
  collie-brightness-keyboard-mute off
  collie-osd -i microphone -m "$(collie-i18n audio.micOn)"
fi
