#!/bin/bash

# collie:summary=Print the active Collie package channel

set -euo pipefail

# Dev is a linked source checkout: COLLIE_PATH points somewhere other than
# the package-backed install at /usr/share/collie. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $COLLIE_PATH != "/usr/share/collie" ]]; then
  echo dev
  exit 0
fi

# omarchy-dev / omarchy-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. collie / omarchy-settings come
# from either the stable or rc mirror, distinguished by collie-version-channel
# (which reports the mirror as its first token).
if pacman -Q omarchy-dev omarchy-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q omarchy omarchy-settings >/dev/null 2>&1; then
  channel=$(collie-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
