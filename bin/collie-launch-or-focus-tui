#!/bin/bash

# collie:summary=Launch a TUI or focus an existing terminal window for it
# collie:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.collie.$(basename "$1")"
fi

LAUNCH_COMMAND="collie-launch-tui $@"

exec collie-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
