#!/bin/bash

# collie:summary=Remove Dropbox and its bar plugin.
# collie:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
collie-plugin-disable collie.dropbox
collie-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Other tray apps need libappindicator too, and naming a required package fails the whole removal
if pacman -Qqtt libappindicator &>/dev/null; then
  collie-pkg-drop libappindicator
fi

echo ""
echo "Dropbox has been removed."
