#!/bin/bash

# collie:summary=Remove the GeForce NOW Flatpak app and its data.
# collie:group=remove
# collie:name=gaming geforce-now

set -e

if collie-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
