#!/bin/bash

# collie:summary=Refresh the current theme from its templates.

THEME_NAME_PATH="$HOME/.local/state/collie/current/theme.name"

# Installers and migrations refresh the theme and then read the app configs it
# writes, so this waits for every retint rather than leaving some running.
if [[ -f $THEME_NAME_PATH ]]; then
  COLLIE_THEME_WAIT=1 COLLIE_THEME_SKIP_BACKGROUND=1 collie-theme-set "$(cat $THEME_NAME_PATH)"
fi
