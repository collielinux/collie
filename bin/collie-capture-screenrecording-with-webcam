#!/bin/bash

# collie:summary=Pick a webcam and start a screen recording with it
# collie:examples=collie capture screenrecording-with-webcam

mapfile -t devices < <(collie-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  collie-notification-send "$(collie-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(collie-menu-select "$(collie-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec collie-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
