#!/bin/bash

# collie:summary=List available themes
# collie:examples=collie theme list | collie theme set "Tokyo Night"

{
  find ~/.config/collie/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$COLLIE_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
