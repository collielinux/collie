#!/bin/bash

# collie:summary=Restore the preinstalled Collie applications (web apps, TUIs, and selected packages).
# collie:requires-sudo=true

if gum confirm --affirmative "$(collie-i18n common.yes)" --negative "$(collie-i18n common.no)" "$(collie-i18n preinstalls.confirmRestore)"; then
  echo -e "Restoring preinstalled Collie applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs).
  collie-refresh-applications || exit 1

  # Re-enable Collie's default mise tools for this user and rebuild their shims.
  if ! collie-mise-default-tools enable; then
    echo -e "\nCould not restore mise tools. Preinstalls remain marked as removed."
    exit 1
  fi

  # Mirrors the list in collie-remove-preinstalls; both track collie-base.packages
  if ! collie-pkg-add \
    aether \
    cliamp \
    pinta \
    moonlight-qt \
    shear \
    monologue \
    tally \
    hype \
    signed; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/collie/preinstalls-removed
  collie-restart-hyprctl
fi
