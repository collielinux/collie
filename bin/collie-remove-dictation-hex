#!/bin/bash

# collie:summary=Remove Hex dictation
# collie:requires-sudo=true

set -e

systemctl --user disable --now hex.service 2>/dev/null || true
collie-pkg-drop hex-bin
systemctl --user daemon-reload

# Hex's settings, history, and downloaded models stay in ~/.local/share/hex.
backend_config="${XDG_CONFIG_HOME:-$HOME/.config}/collie/defaults/dictation"
if [[ -f $backend_config && $(< "$backend_config") == "hex" ]]; then
  rm "$backend_config"
fi

collie-restart-hyprctl
