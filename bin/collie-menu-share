#!/bin/bash

# collie:summary=Share clipboard, files, or folders with LocalSend
# collie:group=share
# collie:name=
# collie:args=<clipboard|file|folder> [path...]
# collie:examples=collie share clipboard | collie share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: collie-menu-share [clipboard|file|folder]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  TEMP_FILE=$(mktemp --suffix=.txt)
  wl-paste >"$TEMP_FILE"
  FILE_ARRAY=("$TEMP_FILE")
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    select_args=(--title "$(collie-i18n share.folderTitle)" --directory)
  else
    select_args=(--title "$(collie-i18n share.filesTitle)" --multiple)
  fi

  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to share.
  picked=$(collie-file-select "${select_args[@]}") || status=$?

  if ((${status:-0} > 1)); then
    collie-notification-send -g "" -u critical "$(collie-i18n share.couldNot)" "$(collie-i18n share.chooserClosed)"
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t FILE_ARRAY <<<"$picked"
fi

# Run LocalSend in its own systemd service (detached from terminal)
systemd-run --user --quiet --collect localsend --headless send "${FILE_ARRAY[@]}"

# Note: Temporary file will remain until system cleanup for clipboard mode
# This ensures the file content is available for the LocalSend GUI

exit 0
