#!/bin/bash

# collie:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# collie:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
collie-pkg-add heroic-games-launcher-bin
collie-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
