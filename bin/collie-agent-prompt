#!/bin/bash

# collie:summary=Launch the default coding agent with a prompt
# collie:args=[--inline] <prompt...>
# collie:examples=collie agent prompt "Review this project"

# Prompts live here rather than on `collie agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: collie agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec collie-agent "${inline[@]}" --prompt "$*"
