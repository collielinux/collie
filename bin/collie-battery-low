#!/bin/bash

# collie:summary=Send the low battery warning notification and run battery-low hooks.
# collie:args=<percentage>
# collie:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: collie-battery-low <percentage>" >&2
  exit 1
fi

level=$1

collie-notification-send -g 󱐋 -u normal "$(collie-i18n battery.lowTitle)" "$(collie-i18n battery.lowBody "$level")" -i battery-caution -t 30000
collie-hook battery-low "$level"
