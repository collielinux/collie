#!/bin/bash

# collie:summary=Toggle mirroring theme changes to and from your herdr machines

collie-toggle herdr-theme-sync

if collie-toggle-enabled herdr-theme-sync; then
  collie-notification-send -g 󰸌 "$(collie-i18n themeSync.enabled)"
else
  collie-notification-send -g 󰸌 "$(collie-i18n themeSync.disabled)"
fi
