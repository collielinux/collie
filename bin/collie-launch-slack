#!/bin/bash

# collie:summary=Launch Slack with live Collie theme support
# collie:args=[slack-arguments...]
# collie:hidden=true

# Slack's own restarts come back through here with the pipe flag the
# launcher added; the launcher adds it again with a pipe behind it.
arguments=()
for argument in "$@"; do
  [[ $argument == "--remote-debugging-pipe" ]] || arguments+=("$argument")
done

if [[ -f $HOME/.local/state/collie/slack/enabled ]]; then
  exec /usr/bin/python "$COLLIE_PATH/default/slack/launcher.py" "${arguments[@]}"
else
  exec /usr/bin/slack "${arguments[@]}"
fi
