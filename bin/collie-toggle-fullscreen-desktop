#!/bin/bash

# collie:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# collie:args=[toggle|on|off]
# collie:examples=collie toggle fullscreen desktop | collie toggle fullscreen desktop off | collie toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if collie-toggle-enabled bar-off && collie-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: collie-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

collie-toggle-bar "$ACTION"
collie-hyprland-toggle window-no-gaps "$ACTION"
