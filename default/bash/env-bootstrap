# Single source of truth for COLLIE_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/collie.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-collie          (Hyprland session via uwsm)
#   /usr/share/collie/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/collie.conf is written by collie-dev-link and reset by
# collie-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/collie.conf ]; then
  . /etc/collie.conf
  : "${COLLIE_PATH:=/usr/share/collie}"
else
  COLLIE_PATH=/usr/share/collie
fi
export COLLIE_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/collie-* via the omarchy package — prepending
# /usr/share/collie/bin would just be noise.
if [ "$COLLIE_PATH" != /usr/share/collie ]; then
  case ":$PATH:" in
    *":${COLLIE_PATH%/}/bin:"*) ;;
    *) PATH="${COLLIE_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
collie_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
collie_wrapper_path=$collie_wrapper_dir
if [ -n "${PATH:-}" ]; then
  collie_remaining_path=$PATH
  while :; do
    collie_path_entry=${collie_remaining_path%%:*}
    if [ "$collie_path_entry" != "$collie_wrapper_dir" ]; then
      collie_wrapper_path="$collie_wrapper_path:$collie_path_entry"
    fi
    case "$collie_remaining_path" in
      *:*) collie_remaining_path=${collie_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$collie_wrapper_path
unset collie_wrapper_dir collie_wrapper_path collie_remaining_path collie_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
