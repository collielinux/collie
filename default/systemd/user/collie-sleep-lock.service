[Unit]
Description=Lock Collie before suspend
# The monitor calls into the running Collie shell. Wait until UWSM has imported
# COLLIE_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=COLLIE_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/collie-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
