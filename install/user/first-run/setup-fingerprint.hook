#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if collie-hw-fingerprint && [[ ! -f /etc/pam.d/collie-lock-fingerprint ]] &&
  collie-done ensure fingerprint-setup-invitation; then
  collie-notification-send -u critical -g 󰈷 "$(collie-i18n firstRun.fingerprintTitle)" \
    "$(collie-i18n firstRun.fingerprintBody)" \
    --exec collie-launch-floating-terminal-with-presentation collie-setup-security-fingerprint
fi
