#!/bin/bash

set -e

# Collie ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(collie-default-agent) ]] && collie-done ensure agent-setup-invitation; then
  collie-notification-send -u critical -g 󰚩 "$(collie-i18n firstRun.agentTitle)" \
    "$(collie-i18n firstRun.agentBody)" \
    --exec collie menu summon setup.default.agent
fi
